{
  "rules": {
    "id_solicitante": {
      ".indexOn": "chats",
      "$solicitanteID": {
        ".read": "auth != null && (!data.child('uid').exists() || data.child('uid').val() == auth.uid)",
        ".write": "auth != null && (!data.child('uid').exists() || data.child('uid').val() == auth.uid)",
        "uid": {
          ".validate": "newData.val() == auth.uid"
        },
        "chats": {
          ".indexOn": ".key",
          "$proveedorID": {
            ".read": "auth != null && (root.child('id_solicitante').child($solicitanteID).child('uid').val() == auth.uid || data.child('proveedorUid').val() == auth.uid)",
            ".write": "auth != null && (root.child('id_solicitante').child($solicitanteID).child('uid').val() == auth.uid || !data.child('proveedorUid').exists() || data.child('proveedorUid').val() == auth.uid) && (!newData.child('proveedorUid').exists() || newData.child('proveedorUid').val() == auth.uid)",
            "proveedorUid": {
              ".validate": "newData.val() == auth.uid"
            }
          }
        }
      }
    },
    "resumen_solicitante": {
      "$solicitanteID": {
        ".read": "auth != null && root.child('id_solicitante').child($solicitanteID).child('uid').val() == auth.uid",
        "$proveedorID": {
          ".write": "auth != null && (root.child('id_solicitante').child($solicitanteID).child('uid').val() == auth.uid || root.child('id_solicitante').child($solicitanteID).child('chats').child($proveedorID).child('proveedorUid').val() == auth.uid)"
        }
      }
    },
    "resumen_proveedor": {
      "$proveedorID": {
        ".read": "auth != null && root.child('id_proveedor').child($proveedorID).child('uid').val() == auth.uid",
        "$solicitanteID": {
          ".write": "auth != null && (root.child('id_proveedor').child($proveedorID).child('uid').val() == auth.uid || root.child('id_solicitante').child($solicitanteID).child('uid').val() == auth.uid)"
        }
      }
    },
    "id_proveedor": {
      "$proveedorID": {
        ".read": "auth != null && (!data.child('uid').exists() || data.child('uid').val() == auth.uid)",
        ".write": "auth != null && (!data.child('uid').exists() || data.child('uid').val() == auth.uid)",
        "uid": {
          ".validate": "newData.val() == auth.uid"
        },
        "chats": {
          "$solicitanteID": {
            ".write": "auth != null && (root.child('id_proveedor').child($proveedorID).child('uid').val() == auth.uid || !data.exists() || newData.val() == data.val())",
            ".validate": "newData.isBoolean() == true"
          }
        }
      }
    }
  }
}
